{
  "name": "partforge",
  "version": "0.116.0",
  "description": "Turn a declarative part definition into a parametric-CAD web app (three.js + Manifold/Replicad). Requires a Vite-based consumer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixiteapps/partforge.git"
  },
  "homepage": "https://github.com/pixiteapps/partforge#readme",
  "bugs": "https://github.com/pixiteapps/partforge/issues",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "bin",
    "types",
    "skills/partforge/SKILL.md",
    "docs/AUTHORING-PARTS.md",
    "docs/ERROR-PATTERNS.md",
    "docs/KERNEL-CONTRACT.md",
    "docs/VECTOR-FORMAT.md",
    "README.md"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./src/framework/worker.js"
    },
    "./geometry": {
      "types": "./types/geometry.d.ts",
      "default": "./src/framework/geometry/polygon.js"
    },
    "./lint": {
      "types": "./types/lint.d.ts",
      "default": "./src/lint.js"
    },
    "./derive": {
      "types": "./types/derive.d.ts",
      "default": "./src/framework/derive.js"
    },
    "./oracle": {
      "types": "./types/oracle.d.ts",
      "default": "./src/oracle.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./src/testing.js"
    },
    "./ingest": {
      "types": "./types/ingest.d.ts",
      "default": "./src/ingest.js"
    },
    "./panel-values": {
      "types": "./types/panel-values.d.ts",
      "default": "./src/panel-values.js"
    },
    "./tokens.css": "./src/framework/tokens.css",
    "./chrome.css": "./src/framework/chrome.css"
  },
  "typesVersions": {
    "*": {
      "worker": [
        "./types/worker.d.ts"
      ],
      "geometry": [
        "./types/geometry.d.ts"
      ],
      "lint": [
        "./types/lint.d.ts"
      ],
      "derive": [
        "./types/derive.d.ts"
      ],
      "oracle": [
        "./types/oracle.d.ts"
      ],
      "testing": [
        "./types/testing.d.ts"
      ],
      "ingest": [
        "./types/ingest.d.ts"
      ],
      "panel-values": [
        "./types/panel-values.d.ts"
      ]
    }
  },
  "bin": {
    "partforge": "./bin/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:dead": "knip",
    "check": "node scripts/check-app.mjs",
    "offset-rates": "node scripts/offset-rates.mjs"
  },
  "peerDependencies": {
    "happy-dom": ">=20"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.1",
    "marked": "^18.0.5",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "pngjs": "^7.0.0",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.35.1",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
